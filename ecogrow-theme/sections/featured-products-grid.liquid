<section class="featured-products">
  <div class="featured-products__header">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.subtext != blank %}
      <p>{{ section.settings.subtext }}</p>
    {% endif %}
  </div>

  <div class="featured-products__grid">
    {% for block in section.blocks %}
      <div class="product-card">
        <div class="product-card__image">
          {% if block.settings.product != blank %}
            {% assign product_data = all_products[block.settings.product] %}
            {% if product_data.featured_image != blank %}
              <img src="{{ product_data.featured_image | img_url: '400x' }}" alt="{{ product_data.title }}" loading="lazy">
            {% else %}
              {{ block.settings.emoji | default: '🌿' }}
            {% endif %}
          {% else %}
            {{ block.settings.emoji | default: '🌿' }}
          {% endif %}
        </div>
        <div class="product-card__info">
          <h3 class="product-card__title">{{ block.settings.title }}</h3>
          <div class="product-card__price">{{ block.settings.price }}</div>
          <a href="{{ block.settings.url | default: '#' }}" class="button button--primary product-card__button">
            Quick Shop
          </a>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Top Picks for This Season"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Hand-picked essentials to elevate your growing space — from seed to harvest."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Product title",
          "default": "Product Name"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$14.99"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Product URL"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Product emoji",
          "default": "🌿"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}