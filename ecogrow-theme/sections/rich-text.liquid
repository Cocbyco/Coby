<section class="rich-text-section" style="padding: var(--spacing-lg) 0; text-align: center;">
  <div class="container" style="max-width: 700px; margin: 0 auto;">
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}
      <p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: var(--spacing-md);">{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_url | default: '/' }}" class="button button--primary">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_text", "label": "Button text" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}