<section class="hero">
  {% if section.settings.background_image != blank %}
    <img src="{{ section.settings.background_image | img_url: '1920x' }}" alt="" class="hero__background" loading="eager">
  {% endif %}
  <div class="hero__content">
    <h1 class="hero__title">{{ section.settings.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
    <p class="hero__text">{{ section.settings.text }}</p>
    <div class="hero__actions">
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_url }}" class="button button--primary">{{ section.settings.button_text }}</a>
      {% endif %}
      {% if section.settings.button_text_2 != blank %}
        <a href="{{ section.settings.button_url_2 }}" class="button button--secondary">{{ section.settings.button_text_2 }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Grow Greener." },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Every Plant, Every Choice, Every Day." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_text", "label": "Primary button", "default": "Shop All Products" },
    { "type": "url", "id": "button_url", "label": "Primary link", "default": "/collections/all" },
    { "type": "text", "id": "button_text_2", "label": "Secondary button", "default": "Our Story" },
    { "type": "url", "id": "button_url_2", "label": "Secondary link", "default": "/pages/about" }
  ],
  "presets": [ { "name": "Hero banner" } ]
}
{% endschema %}