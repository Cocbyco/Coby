<a href="{{ product.url | default: '#' }}" class="product-card">
  <div class="product-card__image">
    {% if product.featured_image != blank %}
      <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}" loading="lazy" width="400" height="400">
    {% else %}
      <span class="product-card__placeholder">{{ product.emoji | default: '🌿' }}</span>
    {% endif %}
  </div>
  <div class="product-card__info">
    <h3 class="product-card__title">{{ product.title | default: block.settings.title }}</h3>
    <div class="product-card__price">{{ product.price | money | default: block.settings.price }}</div>
  </div>
</a>